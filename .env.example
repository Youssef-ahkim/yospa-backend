APP_NAME=Yospa
APP_ENV=production # 'local' for local development
APP_KEY=
APP_DEBUG=false # 'true' for local dev, NEVER in production
APP_URL=https://api.yourdomain.com # 'http://localhost:8000' for local dev

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info # 'debug' for local dev

# Database Configuration (PostgreSQL recommended for production, sqlite :memory: for tests)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=yospa
DB_USERNAME=yospa_user
DB_PASSWORD=

# Session (stateless API - sessions unused by api/*)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Queue Connection (use 'sync' if no queue worker runs, 'database' with supervisor/worker)
QUEUE_CONNECTION=sync

# Cache Store & Rate Limiting
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Sanctum Token Expiration in minutes (default 10080 = 7 days)
SANCTUM_EXPIRATION=10080

# CORS Allowed Origins: comma-separated list of allowed frontend origins (e.g. https://app.yourdomain.com)
# When empty in production, no cross-origin requests are allowed.
# In local dev (APP_ENV=local), defaults to http://localhost:3000 if unset.
CORS_ALLOWED_ORIGINS=https://app.yourdomain.com

# Trusted Proxies: Comma-separated IPs/CIDRs, or '*' if behind a trusted load balancer/reverse proxy
# (e.g. AWS ALB, Cloudflare, Traefik, Nginx). Leave blank if web server handles requests directly.
TRUSTED_PROXIES=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
